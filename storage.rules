rules_version = '2';

// Firebase Storage Security Rules for Competition Day App
service firebase.storage {
  match /b/{bucket}/o {
    // Maps folder - only authenticated admins can upload/read
    match /maps/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (resource == null || resource.metadata.uploadedBy == request.auth.uid) &&
        isAdmin(request.auth.uid);
    }
    
    // Team icons folder - team leads can upload for their own team
    match /team-icons/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (isTeamLead(request.auth.uid, teamId) || isAdmin(request.auth.uid));
    }
    
    // User profile pictures
    match /user-avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == userId || isAdmin(request.auth.uid));
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

// Helper function to check if user is admin
function isAdmin(uid) {
  return exists(/databases/competition/documents/users/$(uid)) &&
    get(/databases/competition/documents/users/$(uid)).data.role == 'admin';
}

// Helper function to check if user is team lead for specific team
function isTeamLead(uid, teamId) {
  return exists(/databases/competition/documents/teams/$(teamId)) &&
    uid in get(/databases/competition/documents/teams/$(teamId)).data.members.keys() &&
    get(/databases/competition/documents/teams/$(teamId)).data.members[uid].role == 'team_lead';
}