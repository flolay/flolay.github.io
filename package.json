{
  "name": "hfi-frontend-vue3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p dist/competitionDay && cp dist/favicon.ico dist/favicon.svg dist/icon.svg dist/competitionDay/ && cp -r dist/assets dist/competitionDay/",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "build:gh-pages": "vite build && cp dist/index.html dist/404.html",
    "build:gh-pages-root": "VITE_BASE_PATH=/ vite build && cp dist/index.html dist/404.html"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@kyvg/vue3-notification": "^3.0.2",
    "@types/jquery": "^3.5.19",
    "@types/leaflet": "^1.9.17",
    "@vueuse/core": "^13.3.0",
    "axios": "^1.9.0",
    "canvas-confetti": "^1.9.3",
    "firebase": "^11.6.0",
    "jquery": "^3.7.1",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^2.1.6",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tsconfig/node18": "^18.2.0",
    "@types/node": "^18.18.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/tsconfig": "^0.4.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.46.0",
    "eslint-plugin-vue": "^9.16.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.4",
    "prettier": "^3.0.0",
    "sass": "^1.66.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.1.6",
    "vite": "^6.3.2",
    "vue-tsc": "^2.2.8"
  }
}
