rules_version = '2';

// Simplified Firebase Storage Security Rules for Competition Day App
// Use this temporarily to test if basic authentication works
service firebase.storage {
  match /b/{bucket}/o {
    // Maps folder - only authenticated users can read/write (temporary)
    match /maps/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Team icons folder - authenticated users can read/write
    match /team-icons/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // User profile pictures - authenticated users can read/write
    match /user-avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}